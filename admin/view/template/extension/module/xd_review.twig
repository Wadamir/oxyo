{{ header }}{{ column_left }}
<div id="content">
    <div class="page-header">
        <div class="container-fluid">
            <div class="pull-right">
                <button type="submit" form="form-xd-review-settings" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
                <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
            </div>
            <h1>{{ heading_title }}</h1>
            <ul class="breadcrumb">
                {% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}
            </ul>
        </div>
    </div>
    <div class="container-fluid">
        {% if error_warning %}
            <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}<button type="button" class="close" data-dismiss="alert">&times;</button></div>
        {% endif %}
        {% if success %}
            <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}<button type="button" class="close" data-dismiss="alert">&times;</button></div>
        {% endif %}
        <ul class="nav nav-tabs">
            <li{% if active_tab == 'settings' %} class="active"{% endif %}><a href="#tab-settings" data-toggle="tab">{{ tab_settings }}</a></li>
            <li{% if active_tab == 'reviews' %} class="active"{% endif %}><a href="#tab-reviews" data-toggle="tab">{{ tab_reviews }}</a></li>
        </ul>
        <div class="tab-content" id="module-xd-review-tabs">
            <div class="tab-pane{% if active_tab == 'settings' %} active{% endif %}" id="tab-settings">
                <div class="panel panel-default">
                    <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-list"></i> {{ text_list }}</h3></div>
                    <div class="panel-body">
                        <p class="help-block">{{ help_widget_layout }}</p>
                        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-xd-review-settings" class="form-horizontal">
                            <div class="form-group">
                                <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
                                <div class="col-sm-10"><select name="module_xd_review_status" id="input-status" class="form-control">
                                        <option value="1"{% if module_xd_review_status %} selected="selected"{% endif %}>{{ text_enabled }}</option>
                                        <option value="0"{% if not module_xd_review_status %} selected="selected"{% endif %}>{{ text_disabled }}</option>
                                    </select></div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-2 control-label" for="input-panel-title">{{ entry_panel_title }}</label>
                                <div class="col-sm-10"><input type="text" name="module_xd_review_panel_title" value="{{ module_xd_review_panel_title }}" id="input-panel-title" class="form-control"/></div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-2 control-label" for="input-limit">{{ entry_limit }}</label>
                                <div class="col-sm-10"><input type="number" min="1" max="100" name="module_xd_review_limit" value="{{ module_xd_review_limit }}" id="input-limit" class="form-control"/></div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-2 control-label" for="input-carousel">{{ entry_carousel }}</label>
                                <div class="col-sm-10"><select name="module_xd_review_carousel" id="input-carousel" class="form-control">
                                        <option value="1"{% if module_xd_review_carousel %} selected="selected"{% endif %}>{{ text_yes }}</option>
                                        <option value="0"{% if not module_xd_review_carousel %} selected="selected"{% endif %}>{{ text_no }}</option>
                                    </select></div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-2 control-label" for="input-moderation">{{ entry_moderation }}</label>
                                <div class="col-sm-10"><select name="module_xd_review_moderation" id="input-moderation" class="form-control">
                                        <option value="1"{% if module_xd_review_moderation %} selected="selected"{% endif %}>{{ text_yes }}</option>
                                        <option value="0"{% if not module_xd_review_moderation %} selected="selected"{% endif %}>{{ text_no }}</option>
                                    </select></div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-2 control-label" for="input-guest">{{ entry_guest }}</label>
                                <div class="col-sm-10"><select name="module_xd_review_guest" id="input-guest" class="form-control">
                                        <option value="1"{% if module_xd_review_guest %} selected="selected"{% endif %}>{{ text_yes }}</option>
                                        <option value="0"{% if not module_xd_review_guest %} selected="selected"{% endif %}>{{ text_no }}</option>
                                    </select></div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-2 control-label" for="input-min-length">{{ entry_min_length }}</label>
                                <div class="col-sm-10"><input type="number" min="1" max="1000" name="module_xd_review_min_length" value="{{ module_xd_review_min_length }}" id="input-min-length" class="form-control"/>
                                    <p class="help-block">{{ help_min_length }}</p>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            <div class="tab-pane{% if active_tab == 'reviews' %} active{% endif %}" id="tab-reviews">
                <div class="row">
                    <div class="col-md-3 col-md-push-9 col-sm-12 hidden-sm hidden-xs">
                        <div class="panel panel-default">
                            <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-filter"></i> {{ text_filter }}</h3></div>
                            <div class="panel-body" style="padding-top: 0; padding-bottom: 0;">
                                <form action="{{ action }}" method="get" id="form-xd-review-reviews" class="">
                                    <input type="hidden" name="route" value="extension/module/xd_review"/>
                                    <input type="hidden" name="user_token" value="{{ user_token }}"/>
                                    <input type="hidden" name="tab" value="reviews"/>
                                    <div class="form-group">
                                        <label class="control-label">{{ entry_author }}</label>
                                        <div class="col-12"><input type="text" name="filter_author" value="{{ filter_author }}" placeholder="{{ entry_author }}" class="form-control"/></div>
                                    </div>
                                    <div class="form-group">
                                        <label class="control-label">{{ entry_filter_product }}</label>
                                        <div class="col-12"><input type="text" name="filter_product" value="{{ filter_product }}" placeholder="{{ entry_filter_product }}" class="form-control"/></div>
                                    </div>
                                    <div class="form-group">
                                        <label class="control-label">{{ entry_filter_rating }}</label>
                                        <div class="col-12"><select name="filter_rating" class="form-control">
                                                {% for rating in filter_rating_options %}
                                                    <option value="{{ rating[0] }}"{% if filter_rating == rating[0] %} selected="selected"{% endif %}>{{ rating[1] }}</option>
                                                {% endfor %}
                                            </select></div>
                                    </div>
                                    <div class="form-group">
                                        <label class="control-label">{{ entry_filter_status }}</label>
                                        <div class="col-12"><select name="filter_status" class="form-control">
                                                {% for status in filter_status_options %}
                                                    <option value="{{ status[0] }}"{% if filter_status == status[0] %} selected="selected"{% endif %}>{{ status[1] }}</option>
                                                {% endfor %}
                                            </select></div>
                                    </div>
                                    <div class="form-group">
                                        <div class="text-right">
                                            <button type="submit" id="button-filter" data-toggle="tooltip" title="{{ button_filter }}" class="btn btn-primary"><i class="fa fa-filter"></i>&nbsp;{{ text_filter }}</button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-9 col-md-pull-3 col-sm-12">
                        <div class="panel panel-default">
                            <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_list }}</h3></div>
                            <div class="panel-body">
                                <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-review" class="form-horizontal">
                                    <input type="hidden" name="tab" value="reviews"/>
                                    <div class="table-responsive">
                                        <table class="table table-bordered table-hover">
                                            <thead>
                                                <tr>
                                                    <td class="text-center"><input type="checkbox" onclick="$('#form-review input[type=checkbox]').not(this).prop('checked', this.checked);"/></td>
                                                    <td class="text-left">{{ column_product }}</td>
                                                    <td class="text-left">{{ column_author }}</td>
                                                    <td class="text-left">{{ column_text }}</td>
                                                    <td class="text-center">{{ column_rating }}</td>
                                                    <td class="text-center">{{ column_status }}</td>
                                                    <td class="text-left">{{ column_date_added }}</td>
                                                    <td class="text-right" style="min-width:100px">{{ column_action }}</td>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                {% if reviews %}
                                                    {% for review in reviews %}
                                                        <tr>
                                                            <td class="text-center"><input type="checkbox" name="selected[]" value="{{ review.review_id }}"{% if review.review_id in selected_reviews %} checked="checked"{% endif %}/></td>
                                                            <td class="text-left">{{ review.product_name }}</td>
                                                            <td class="text-left">{{ review.author }}</td>
                                                            <td class="text-left">
                                                                <details>
                                                                    <summary style="display: block; max-width: 260px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; cursor: pointer;">{{ review.text }}</summary>
                                                                    <div style="max-width: 260px; white-space: normal; overflow-wrap: anywhere;">{{ review.text }}</div>
                                                                </details>
                                                            </td>
                                                            <td class="text-center">{{ review.rating }}</td>
                                                            <td class="text-center">{% if review.status == 1 %}<span class="label label-success">{{ text_approved }}</span>{% else %}<span class="label label-warning">{{ text_pending }}</span>{% endif %}</td>
                                                            <td class="text-left">{{ review.date_added }}</td>
                                                            <td class="text-right">
                                                                <a href="{{ review.approve }}" data-toggle="tooltip" title="{{ button_approve }}" class="btn btn-success btn-xs"><i class="fa fa-check"></i></a>
                                                                <a href="{{ review.reject }}" data-toggle="tooltip" title="{{ button_reject }}" class="btn btn-warning btn-xs"><i class="fa fa-ban"></i></a>
                                                                <a href="{{ review.delete }}" data-toggle="tooltip" title="{{ button_delete }}" class="btn btn-danger btn-xs"><i class="fa fa-trash-o"></i></a>
                                                            </td>
                                                        </tr>
                                                    {% endfor %}
                                                {% else %}
                                                    <tr><td class="text-center" colspan="8">{{ text_no_results }}</td></tr>
                                                {% endif %}
                                            </tbody>
                                        </table>
                                    </div>
                                    <div class="form-group">
                                        <label for="input-action" class="col-md-3 control-label text-right">{{ text_selected }}</label>
                                        <div class="col-md-6">
                                            <select name="action" id="input-action" class="form-control">
                                                <option value="approve"{% if selected_action == 'approve' %} selected="selected"{% endif %}>{{ button_approve }}</option>
                                                <option value="reject"{% if selected_action == 'reject' %} selected="selected"{% endif %}>{{ button_reject }}</option>
                                                <option value="delete"{% if selected_action == 'delete' %} selected="selected"{% endif %}>{{ button_delete }}</option>
                                            </select>
                                        </div>
                                        <div class="col-md-3">
                                            <button type="submit" id="button-action" form="form-review" data-toggle="tooltip" title="{{ button_action }}" class="btn btn-primary" disabled="disabled">{{ button_submit }}</button>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <div class="col-sm-offset-2 col-sm-10">{{ results }}</div>
                                        <div class="col-sm-6 text-left">{{ pagination }}</div>
                                    </div>
                                </form>
                                <script type="text/javascript">
                                    $('#form-review').on('change', 'input[type="checkbox"]', function() {
                                        $('#button-action').prop('disabled', $('#form-review input[name="selected[]"]:checked').length === 0);
                                    });
                                    $('#button-action').prop('disabled', $('#form-review input[name="selected[]"]:checked').length === 0);
                                </script>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{{ footer }}
