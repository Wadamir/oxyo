  <script>
    var filter_country_id = '{{ filter_country_id }}';
    var filter_zone_id = '{{ filter_zone_id }}';

    document.addEventListener('DOMContentLoaded', function() {
      $("select[name='filter_country_id']").trigger('change');
    })

    $("select[name='filter_country_id']").on('change', function() {

      filter_country_id = this.value;

      $("select[name='filter_zone_id'] option").remove();

      $.ajax({
        url: 'index.php?route=localisation/country/country&user_token={{ user_token }}&country_id=' + filter_country_id,
        dataType: 'json',
        beforeSend: function() {
          $("select[name='filter_zone_id']").prop('disabled', true);
          $(".filter-buttons button").prop('disabled', true);
        },
        complete: function() {
          $("select[name='filter_zone_id']").prop('disabled', false);
          $(".filter-buttons button").prop('disabled', false);
        },
        success: function(json) {
          if (json['zone']) {
            var html = '';
            html += '<option value="">{{ text_all }}</option>';

            for (var i = 0; i < json['zone'].length; i++) {
              if (json['zone'][i]['zone_id'] == filter_zone_id) {
                html += '<option value="' + json['zone'][i]['zone_id'] + '" selected>' + json['zone'][i]['name'] + '</option>';
              } else {
                html += '<option value="' + json['zone'][i]['zone_id'] + '">' + json['zone'][i]['name'] + '</option>';
              }
            }

            $("select[name='filter_zone_id']").html(html);
          }
        }
      });
    });
  </script>
  <script>
    showRewardCustomers();

    $("input[name^='selected']").on('click', function() {

      if (!$("#form-reward input[name='customer_filter']").is(':checked')) {

        var customer_id = Number(this.value);

        if (customer_id) {

          var reward_customer = {};

          if (localStorage.getItem('reward_customers') !== null) {
            reward_customer = JSON.parse(localStorage.getItem('reward_customers'));
          }

          if (this.checked) {
            reward_customer[customer_id] = $("#customers .customer-name-" + customer_id).text();
          } else {
            delete reward_customer[customer_id];
          }

          localStorage.setItem('reward_customers', JSON.stringify(reward_customer));

          showRewardCustomers();
        }
      }
    });

    $("#form-reward input[name='customer_filter']").on('click', function(){

      if ($(this).is(':checked')) {
        localStorage.removeItem('reward_customers');
        showRewardCustomers();
      }
    });

    $("#button-clear-customers").on('click', function(){

      localStorage.removeItem('reward_customers');
      showRewardCustomers();
    })

    function showRewardCustomers() {

      $("#reward-customers").html('');

      if (localStorage.getItem('reward_customers') !== null) {
        const reward_customer = JSON.parse(localStorage.getItem('reward_customers'));

        var html = '';

        for (const customer_id in reward_customer) {
          if (customer_id) {
            html += ' <div>';
            html += '   <i class="fa fa-minus-circle"></i> ' + reward_customer[customer_id];
            html += '   <input type="hidden" name="reward_customers[]" value="' + customer_id + '">';
            html += ' </div>';
          }
        }

        $("#reward-customers").html(html);

        $("#customers input[name^='selected']").each(function() {
          if (reward_customer[Number(this.value)]) {
            this.checked = true;
          } else {
            this.checked = false;
          }
        })
      } else {
        $('input[name^=\'selected\']').prop('checked', false);
      }
    }
  </script>
