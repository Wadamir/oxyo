  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const button_shortcodes = document.getElementById('button-show-shortcodes');
      const block_shortcodes = document.getElementById('shortcodes');
      const block_mail_sample = document.getElementById('mail-sample');

      button_shortcodes.addEventListener('click', function() {
      
        if (block_shortcodes.classList.contains('hide')) {
          block_mail_sample.classList.remove('col-sm-12');
          block_mail_sample.classList.add('col-sm-8');
          block_shortcodes.classList.remove('hide');

          button_shortcodes.textContent = '{{ button_hide_shortcodes }}';
        } else {
          block_shortcodes.classList.add('hide');
          block_mail_sample.classList.remove('col-sm-8');
          block_mail_sample.classList.add('col-sm-12');

          button_shortcodes.textContent = '{{ button_show_shortcodes }}';
        }
      })
