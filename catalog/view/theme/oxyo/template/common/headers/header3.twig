<div class="header-wrapper header3">
    {% if top_line_style %}
        <div class="top_line">
            <div class="container {{ top_line_width }}">
                <div class="table">
                    <div class="table-cell left sm-text-center xs-text-center">
                        <div class="promo-message">{{ promo_message }}</div>
                    </div>
                    <div class="table-cell text-end hidden-xs hidden-sm">
                        <div class="links">
                            <ul>
                                {% include 'oxyo/template/common/static_links.twig' %}
                            </ul>
                            {% if lang_curr_title %}
                                <div class="setting-ul">
                                    <div class="setting-li dropdown-wrapper from-left lang-curr-trigger nowrap">
                                        <a>
                                            <span>{{ lang_curr_title }}</span>
                                        </a>
                                        <div class="dropdown-content dropdown-right lang-curr-wrapper">
                                            {{ language }}
                                            {{ currency }}
                                        </div>
                                    </div>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
                <!-- .table ends -->
            </div>
            <!-- .container ends -->
        </div>
        <!-- .top_line ends -->
    {% endif %}
    <div class="container-fluid sticky-header">
        <div class="container">
            <div class="row header-main">
                <div class="col-4 d-flex justify-content-start">
                    <div class="icon-element menu-element d-md-none d-xl-none d-xxl-none p-0">
                        <a class="shortcut-wrapper menu-trigger">
                            <svg class="ham hamRotate ham1" viewbox="0 0 100 100" width="40px" height="40px">
                                <path class="line top" d="m 30,33 h 40 c 0,0 9.044436,-0.654587 9.044436,-8.508902 0,-7.854315 -8.024349,-11.958003 -14.89975,-10.85914 -6.875401,1.098863 -13.637059,4.171617 -13.637059,16.368042 v 40"/>
                                <path class="line middle" d="m 30,50 h 40"/>
                                <path class="line bottom" d="m 30,67 h 40 c 12.796276,0 15.357889,-11.717785 15.357889,-26.851538 0,-15.133752 -4.786586,-27.274118 -16.667516,-27.274118 -11.88093,0 -18.499247,6.994427 -18.435284,17.125656 l 0.252538,40"/>
                            </svg>
                        </a>
                    </div>
                    {% for contact in contact_array %}

                        {# Determine if the contact should be displayed #}
                        {% set flags = contact.header_flags|default({}) %}
                        {% set show_contact =
                            contact.value
                            and (flags.xs or flags.md or flags.lg or flags.xl)
                        %}

                        {% if show_contact %}
                            <div class="{{ contact.header_class }}">
                                <a
                                    href="{{ contact.link }}"
                                    class="shortcut-wrapper"
                                    {% if contact.onclick %}onclick="{{ contact.onclick }}"{% endif %}
                                    {% if contact.link %}target="_blank"{% endif %}
                                >

                                    {% if contact.icon_svg %}
                                        {{ contact.icon_svg|raw }}
                                    {% else %}
                                        {{ contact.icon|raw }}
                                    {% endif %}

                                    <span class="nowrap d-none{% if contact.name == 'callback' %} d-xl-block animate-content{% endif %}">
                                        {{ contact.value }}
                                    </span>
                                </a>
                            </div>
                        {% endif %}

                    {% endfor %}
                </div>
                <div class="col-4 d-flex justify-content-center">
                    {% if logo %}
                        <div id="logo">
                            <a href="{{ home }}"><img src="{{ logo }}" title="{{ name }}" alt="{{ name }}"/></a>
                        </div>
                    {% endif %}
                </div>
                <div class="col-4 d-flex justify-content-end">
                    {% if header_search %}
                        <div class="icon-element d-none d-xl-block">
                            <div id="search" class="dropdown-wrapper from-top hidden-sm hidden-xs">                            
                                <a class="shortcut-wrapper search-trigger new-icon">
                                    <i class="icon-magnifier icon"></i>
                                </a>
                                <div class="dropdown-content dropdown-right">
                                    <div class="search-dropdown-holder">
                                        <div class="search-holder">
                                            {{ oxyo_search }}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endif %}
                    {% if header_login %}
                        <div class="icon-element">
                            <div id="account" class="dropdown-wrapper from-top">
                                <a class="shortcut-wrapper new-icon" href="{{ account }}">
                                    <i class="bi bi-person-fill"></i>
                                </a>
                            </div>
                        </div>
                    {% endif %}
                    <div class="icon-element">
                        <div id="wishlist" class="dropdown-wrapper from-top">
                            <a class="shortcut-wrapper wishlist-trigger new-icon" href="{{ wishlist }}">
                                <i class="bi bi-heart-fill"></i>                            
                                <div id="wishlist-total" class="counter_wrapper">
                                    <span class="counter wishlist-counter">{{ wishlist_counter }}</span>
                                </div>                                   
                            </a>                         
                        </div>
                    </div>
                    <div class="icon-element">
                        <div id="cart" class="dropdown-wrapper from-top">
                            <a href="{{ shopping_cart }}" class="shortcut-wrapper cart-trigger new-icon">
                                <i class="bi bi-bag-fill"></i>
                                <div id="cart-total" class="counter_wrapper">
                                    <span class="counter cart-total-items">{{ cart_items }}</span>
                                    <span class="slash d-none d-xl-block">/</span>
                                    <span class="cart-total-amount d-none d-xl-block">{{ cart_amount }}</span>
                                </div>
                            </a>
                            <div class="dropdown-content dropdown-right hidden-sm hidden-xs">{{ cart }}</div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- .row.header_main ends -->
        </div>
    </div>
    <!-- .container-fluid.sticky-header ends -->
    {% if primary_menu %}
        <div class="container-fluid main-menu-wrapper d-none d-md-block d-xl-block">
            <div class="container">
                <div class="main-menu text-center">
                    <ul class="categories">
                        {% if primary_menu == 'oc' %}
                            <!-- Default menu -->
                            {{ default_menu }}
                        {% elseif primary_menu is defined %}
                            <!-- Mega menu -->
                            {% for key, row in primary_menu_desktop %}
                                {% include 'oxyo/template/common/menus/mega_menu.twig' %}
                            {% endfor %}
                        {% endif %}
                    </ul>
                </div>
            </div>
        </div>
        <!-- .container-fluid.menu ends -->
    {% endif %}    
    <div class="container-fluid sticky-holder"></div>
</div>
<!-- .header_wrapper ends -->
