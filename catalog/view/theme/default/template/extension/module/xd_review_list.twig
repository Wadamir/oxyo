{% if reviews %}
    {% if carousel %}
        <div class="xd-review-swiper-viewport">
            <div id="xd-review-carousel" class="swiper-container xd-review-swiper">
                <div class="swiper-wrapper">
                {% for review in reviews %}
                    <div class="swiper-slide">
                        <div class="xd-review-card">
                            <div class="xd-review-card-header">
                                <div class="xd-review-avatar">{{ review.author_initial }}</div>
                                <span class="xd-review-author">{{ review.author }}</span>
                                <div class="xd-review-stars">
                                    {% for star in 1..5 %}
                                        {% if review.rating >= star %}<i class="fa fa-star"></i>{% else %}<i class="fa fa-star-o"></i>{% endif %}
                                    {% endfor %}
                                </div>
                            </div>
                            <p class="xd-review-text">{{ review.text }}</p>
                            <div class="xd-review-card-footer">
                                <div class="xd-review-product-images">
                                    {% for image in review.product_images %}
                                        {% if image %}<img src="{{ image }}" alt="{{ review.author }}">{% endif %}
                                    {% endfor %}
                                </div>
                                {% if review.product_url %}
                                    <a href="{{ review.product_url }}" class="xd-review-open" aria-label="Open product">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-up-right-square" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M15 2a1 1 0 0 0-1-1H2a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1zM0 2a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2zm5.854 8.803a.5.5 0 1 1-.708-.707L9.243 6H6.475a.5.5 0 1 1 0-1h3.975a.5.5 0 0 1 .5.5v3.975a.5.5 0 1 1-1 0V6.707z"/></svg>
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
                </div>
            </div>
            {% if reviews|length > 1 %}
                <div class="xd-review-swiper-pager">
                    <div class="xd-review-swiper-button-prev"><i class="fa fa-angle-left"></i></div>
                    <div class="xd-review-swiper-button-next"><i class="fa fa-angle-right"></i></div>
                </div>
            {% endif %}
        </div>
    {% else %}
        <div class="row xd-review-items">
            {% for review in reviews %}
                <div class="col-xs-12 col-sm-12 col-md-6 col-lg-4">
                    <div class="xd-review-card">
                        <div class="xd-review-card-header">
                            <div class="xd-review-avatar">{{ review.author_initial }}</div>
                            <span class="xd-review-author">{{ review.author }}</span>
                            <div class="xd-review-stars">
                                {% for star in 1..5 %}
                                    {% if review.rating >= star %}<i class="fa fa-star"></i>{% else %}<i class="fa fa-star-o"></i>{% endif %}
                                {% endfor %}
                            </div>
                        </div>
                        <p class="xd-review-text">{{ review.text }}</p>
                        <div class="xd-review-card-footer">
                            <div class="xd-review-product-images">
                                {% for image in review.product_images %}
                                    {% if image %}<img src="{{ image }}" alt="{{ review.author }}">{% endif %}
                                {% endfor %}
                            </div>
                            {% if review.product_url %}
                                <a href="{{ review.product_url }}" class="xd-review-open" aria-label="Open product">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-up-right-square" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M15 2a1 1 0 0 0-1-1H2a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1zM0 2a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2zm5.854 8.803a.5.5 0 1 1-.708-.707L9.243 6H6.475a.5.5 0 1 1 0-1h3.975a.5.5 0 0 1 .5.5v3.975a.5.5 0 1 1-1 0V6.707z"/></svg>
                                </a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
    {% if not carousel %}
        <div class="xd-review-pagination">{{ pagination }}</div>
    {% endif %}
{% else %}
    <p>{{ text_no_reviews }}</p>
{% endif %}
